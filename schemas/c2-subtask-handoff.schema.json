{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2-subtask-handoff",
  "title": "C2 Subtask Handoff",
  "type": "object",
  "required": [
    "parent_run_id",
    "subtask_id",
    "objective",
    "constraints",
    "idempotency_key",
    "policy_version"
  ],
  "properties": {
    "parent_run_id": {"type": "string", "minLength": 1},
    "subtask_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "constraints": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "idempotency_key": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
  },
  "additionalProperties": false
}
