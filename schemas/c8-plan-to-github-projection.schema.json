{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c8-plan-to-github-projection",
  "title": "C8 Plan to GitHub Projection",
  "type": "object",
  "required": [
    "initiative_id",
    "plan_doc_id",
    "plan_item_id",
    "target_repo",
    "sync_key",
    "projection_status"
  ],
  "properties": {
    "initiative_id": {"type": "string", "minLength": 1},
    "plan_doc_id": {"type": "string", "minLength": 1},
    "plan_item_id": {"type": "string", "minLength": 1},
    "target_repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "issue_number": {"type": "integer", "minimum": 1},
    "project_item_id": {"type": "string", "minLength": 1},
    "sync_key": {"type": "string", "minLength": 1},
    "projection_status": {"type": "string", "enum": ["projected", "reconciled", "drifted"]}
  },
  "additionalProperties": false
}
