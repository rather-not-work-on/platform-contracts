{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consumer-contract-pin-evidence",
  "title": "Consumer Contract Pin Evidence",
  "type": "object",
  "required": [
    "generated_at_utc",
    "source_repo",
    "bundle_version",
    "consumer_count",
    "consumer_results"
  ],
  "properties": {
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_repo": {
      "type": "string",
      "const": "rather-not-work-on/platform-contracts"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "consumer_count": {
      "type": "integer",
      "minimum": 1
    },
    "consumer_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "consumer_repo",
          "pin_path",
          "verdict",
          "errors"
        ],
        "properties": {
          "consumer_repo": {
            "type": "string",
            "minLength": 1
          },
          "pin_path": {
            "type": "string",
            "minLength": 1
          },
          "contract_bundle_version": {
            "type": "string",
            "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
          },
          "pinned_contracts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
