{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract-bundle-evidence",
  "title": "Contract Bundle Evidence",
  "type": "object",
  "required": [
    "generated_at_utc",
    "source_repo",
    "bundle_version",
    "schema_count",
    "schemas"
  ],
  "properties": {
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_repo": {
      "type": "string",
      "const": "rather-not-work-on/platform-contracts"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "schema_count": {
      "type": "integer",
      "minimum": 1
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_name",
          "contract_id",
          "path",
          "sha256"
        ],
        "properties": {
          "schema_name": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
