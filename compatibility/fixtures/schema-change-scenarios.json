{
  "scenarios": [
    {
      "id": "S1",
      "description": "optional property addition only",
      "expected_bump": "minor",
      "before_schema": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "after_schema": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          },
          "new_hint": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "S2",
      "description": "required key removed",
      "expected_bump": "major",
      "before_schema": {
        "type": "object",
        "required": ["run_id", "status"],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "after_schema": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "S3",
      "description": "enum value added with fallback",
      "expected_bump": "minor",
      "before_schema": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "done"]
          }
        }
      },
      "after_schema": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["todo", "in_progress", "done", "blocked"]
          }
        }
      }
    },
    {
      "id": "S4",
      "description": "documentation-only comment update",
      "expected_bump": "patch",
      "before_schema": {
        "type": "object",
        "description": "Execution result",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "after_schema": {
        "type": "object",
        "description": "Execution result for external clients",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    }
  ]
}
